// Shoppa's schema.
//
// It deliberately contains only the grocery, price-tracking and minimum
// identity data this product owns. Shoppa is the sole migration owner of its
// database, so give it one of its own.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// IDENTITY — the minimum needed for passkey and password sign-in.
// ============================================================================

// `users.email` is stored lowercase and trimmed — src/lib/email.ts is the rule
// and src/server/setup.ts is the only writer. Migration
// 20260902190000_normalize_user_emails rewrote the rows that predate it and
// added `users_email_lower_key`, a UNIQUE index on lower(email) that Prisma
// cannot express here. It exists in SQL only: do not "clean it up" from a
// `migrate dev` diff, or the invariant goes back to being the code's alone.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  tokenVersion  Int       @default(0) @map("token_version")
  name          String?
  image         String?
  emailVerified DateTime? @map("email_verified")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  webauthnCredentials WebAuthnCredential[]
  groceryItemsAdded   GroceryItem[]
  voiceTokens         VoiceToken[]
  invitationsCreated  Invitation[] @relation("InvitationCreatedBy")
  invitationsRedeemed Invitation[] @relation("InvitationRedeemedBy")

  @@map("users")
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  credentialId String   @unique @map("credential_id")
  publicKey    String   @map("public_key") @db.Text
  counter      BigInt
  transports   String[]
  deviceName   String   @map("device_name")
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

// One row, created by the migration. `claimed_at` is what makes the first-run
// claim atomic: registration updates it conditionally inside the same
// transaction that creates the account, so a second concurrent claim finds
// nothing to update and rolls back.
model InstanceSetup {
  id        String    @id @default("singleton")
  claimedAt DateTime? @map("claimed_at")
  seededAt  DateTime? @map("seeded_at")

  @@map("instance_setup")
}

// A single-use, time-limited link that lets an existing member add somebody to
// this instance. Only the hash of the token is stored, so a database read never
// yields a usable invitation.
//
// `used_at` is the single-use marker AND the revocation marker: revoking sets
// it, so a revocation and a redemption arriving together contend for the same
// row lock and Postgres decides between them. A separate `revoked_at` would be
// a second thing to check in the conditional UPDATE and a second way to forget.
// `redeemed_by_user_id` is what tells the two apart afterwards — and it is the
// only record of who came in through which link.
model Invitation {
  id               String    @id @default(cuid())
  tokenHash        String    @unique @map("token_hash")
  expiresAt        DateTime  @map("expires_at")
  usedAt           DateTime? @map("used_at")
  createdByUserId  String    @map("created_by_user_id")
  redeemedByUserId String?   @map("redeemed_by_user_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  createdBy User  @relation("InvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting the person who came in must not delete the
  // record that somebody did. The row survives saying "used", just not by whom.
  redeemedBy User? @relation("InvitationRedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@index([expiresAt])
  @@map("invitations")
}

enum SecurityEventType {
  LOGIN_ATTEMPT
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  RATE_LIMITED
  INVALID_ORIGIN
  SUSPICIOUS_REQUEST
  SESSION_EXPIRED
  API_ERROR
  PASSKEY_REGISTERED
  PASSKEY_DELETED
  // Written only by scripts/auth-password.mjs, from outside the application:
  // the rescue is the one path that rewrites a credential with no session and
  // no authentication, so this row is the only trace it leaves behind.
  PASSWORD_RESET
}

enum SecuritySeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

model SecurityLog {
  id        String            @id @default(cuid())
  eventType SecurityEventType @map("event_type")
  severity  SecuritySeverity  @default(INFO)
  ipAddress String?           @map("ip_address")
  userAgent String?           @map("user_agent") @db.Text
  userId    String?           @map("user_id")
  email     String?
  endpoint  String?
  origin    String?
  details   String?           @db.Text
  success   Boolean           @default(false)
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([eventType, createdAt])
  @@index([ipAddress, createdAt])
  @@index([userId, createdAt])
  @@index([severity, createdAt])
  @@map("security_logs")
}

// ============================================================================
// GROCERY — household-shared by product contract, so list rows have no owner.
// ============================================================================

enum GroceryItemSource {
  APP
  SIRI
}

enum HintOrigin {
  SEED
  LEARNED
}

model GroceryStore {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items      GroceryItem[]
  storeHints ItemCategoryHint[]

  @@map("grocery_stores")
}

model GroceryCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  // Set only while `name` is still the factory name this installation was
  // seeded with. Renaming a category clears the claim to translate it, so the
  // interface keeps showing the name its household chose.
  nameKey   String?  @map("name_key")
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items GroceryItem[]
  hints ItemCategoryHint[]

  @@map("grocery_categories")
}

model GroceryItem {
  id             String            @id @default(cuid())
  name           String
  normalizedName String            @map("normalized_name")
  storeId        String?           @map("store_id")
  categoryId     String?           @map("category_id")
  quantity       Float?
  unit           String?
  checked        Boolean           @default(false)
  source         GroceryItemSource @default(APP)
  addedByUserId  String?           @map("added_by_user_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  checkedAt      DateTime?         @map("checked_at")

  store    GroceryStore?    @relation(fields: [storeId], references: [id], onDelete: SetNull)
  category GroceryCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  addedBy  User?            @relation(fields: [addedByUserId], references: [id], onDelete: SetNull)

  @@index([storeId, checked])
  @@index([storeId, categoryId])
  @@index([checked, checkedAt])
  @@index([normalizedName])
  @@map("grocery_items")
}

model ItemCategoryHint {
  id             String     @id @default(cuid())
  normalizedName String     @unique @map("normalized_name")
  categoryId     String?    @map("category_id")
  storeHintId    String?    @map("store_hint_id")
  origin         HintOrigin @default(SEED)
  updatedAt      DateTime   @updatedAt @map("updated_at")

  category  GroceryCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  storeHint GroceryStore?    @relation(fields: [storeHintId], references: [id], onDelete: SetNull)

  @@map("item_category_hints")
}

model VoiceToken {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  label      String
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("voice_tokens")
}

// ============================================================================
// PRICE TRACKING — the app owns the state and the alert decision; the
// download and, in assisted mode, the Telegram send may happen elsewhere.
// ============================================================================

model TrackedProduct {
  id              String    @id @default(cuid())
  url             String    @unique
  domain          String
  title           String
  imageUrl        String?   @map("image_url")
  basePrice       Decimal   @map("base_price") @db.Decimal(12, 2)
  currency        String    @default("EUR")
  currentPrice    Decimal?  @map("current_price") @db.Decimal(12, 2)
  lowestPrice     Decimal?  @map("lowest_price") @db.Decimal(12, 2)
  lowestAt        DateTime? @map("lowest_at")
  priceHintSource String?   @map("price_hint_source")
  alertActive     Boolean   @default(false) @map("alert_active")
  isActive        Boolean   @default(true) @map("is_active")
  lastCheckedAt   DateTime? @map("last_checked_at")
  failCount       Int       @default(0) @map("fail_count")
  failNotified    Boolean   @default(false) @map("fail_notified")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  checks PriceCheck[]

  @@index([isActive, lastCheckedAt])
  @@map("tracked_products")
}

model PriceCheck {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  price     Decimal  @db.Decimal(12, 2)
  checkedAt DateTime @default(now()) @map("checked_at")

  product TrackedProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, checkedAt])
  @@map("price_checks")
}

