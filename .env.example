# Shoppa — copy this file to .env and edit it.
#
# `docker compose up -d` reads .env from this directory. Full reference in
# docs/installation.md.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# How this instance is reached from a browser: scheme, host and port, no path.
# Its SCHEME decides cookie security, HSTS and the CSRF origin check, so an
# https:// value on a plain-HTTP instance makes the browser drop the session
# cookie and login appears to do nothing.
APP_ORIGIN=http://localhost:3004

# openssl rand -base64 32
# Signs sessions and the WebAuthn challenge cookie, and seeds SETUP_TOKEN.
# Changing it invalidates every session and changes the derived install token.
AUTH_SECRET=

# The password of the `db` service in compose.yaml. Pick one before the first
# `up`: it is baked into the volume when Postgres initialises it.
POSTGRES_PASSWORD=

# Only when you point Shoppa at a database you already run. compose.yaml builds
# this value from POSTGRES_PASSWORD, so leave it alone if you use that file.
# DATABASE_URL=

# Working on the code rather than installing it? That is a different file:
# development reads .env.local, which is what prisma.config.ts, the seed and the
# test runner load. Nothing reads .env except Compose. See README.md.

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# auto (default) | passkey | password. An unrecognised value is refused rather
# than defaulted; the check runs on the first request, so a typo here is a
# container that comes up and answers 500 to everything.
# `passkey` on a plain-HTTP instance is a configuration with no way in.
AUTH_MODE=auto

# none (default) | x-real-ip | xff | cloudflare. Which header is believed to
# carry the client IP. With `none` there is no trustworthy address, so per-IP
# rate limiting is off; an instance on the internet belongs behind a proxy you
# control, with this set to match the header that proxy writes.
TRUSTED_PROXY=none

# local (default) | assisted. `local` reads product pages from this host.
# `assisted` expects a fetcher inside your own network and opens the three
# machine-to-machine endpoints, which answer 410 otherwise.
PRICE_FETCH_MODE=local

# When the daily price run fires, or `off`. Five fields; minute and hour accept
# `*`, a number or `*/n`, and the other three must be `*`.
PRICE_CHECK_CRON=0 8 * * *

# The clock PRICE_CHECK_CRON is read in. A container is UTC unless you say
# otherwise, so `0 8 * * *` fires at 09:00 or 10:00 local across most of Europe.
TZ=UTC

# The token that claims an unclaimed instance. Empty means it is derived from
# AUTH_SECRET — the same value on every boot, in every worker, with nothing to
# persist — and printed to the container log while the instance has no owner.
# Set it to a value of your own if you would rather not read the log to install.
SETUP_TOKEN=

# Price-drop alerts. Both, or neither does anything; missing configuration is a
# no-op with one warning, never a failure.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bearer key for the machine-to-machine price endpoints. Required in `assisted`
# mode, where those routes answer 500 while it is unset.
N8N_API_KEY=

# Only if your passkeys were registered against a different relying-party id or
# origin than APP_ORIGIN gives — usually a parent domain. Both default from
# APP_ORIGIN, and CHANGING EITHER INVALIDATES EVERY PASSKEY ALREADY REGISTERED.
# Defined but empty is a fatal error on purpose: delete the line or give it a
# value, never leave it blank.
# WEBAUTHN_RP_ID=
# WEBAUTHN_ORIGIN=
